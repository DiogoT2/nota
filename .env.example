# Copiar para .env. O .env nunca é commitado — ver .gitignore.
#
# Regra que não tem excepção: uma variável com prefixo EXPO_PUBLIC_ entra no
# bundle da app e é legível por qualquer pessoa que descarregue o IPA ou o APK.
# Tudo o resto vive no servidor — Edge Functions e CI — e nunca é referido em
# código dentro de app/ ou src/. O script `npm run check:secrets` verifica-o.

# ── Cliente: público por definição ───────────────────────────────────────────
# A URL do projecto e a chave anon são públicas por desenho. Quem protege os
# dados é a RLS, não o segredo da chave. Se a RLS estiver certa, a chave anon
# no bundle é inofensiva; se estiver errada, escondê-la não salva nada.
#
# Estes dois valores não se vão buscar a lado nenhum: são as moradas dos
# contentores que o `npm run db:start` levanta. As chaves locais saem do
# `npx supabase status`. NÃO uses aqui chaves de um projecto da cloud — o
# emissor não bate certo com o do Postgres local e tudo responde 401.
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# ── Servidor: nunca no bundle ────────────────────────────────────────────────
# Ignora a RLS por completo. Só em Edge Functions e no CI.
SUPABASE_SERVICE_ROLE_KEY=

# TMDB. Proibição permanente: nunca é chamado a partir do cliente.
# Preferir o token v4 (Bearer, em cabeçalho) à chave v3 (na query string): uma
# chave numa URL fica em logs de proxies e de servidores por onde a chamada
# passe. A v3 fica como alternativa.
TMDB_READ_ACCESS_TOKEN=
TMDB_API_KEY=

# Base de dados directa, para migrações e pgTAP.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
