{
  "name": "nota",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "private": true,
  "scripts": {
    "android": "expo start --android",
    "check:definer": "node scripts/check-security-definer.mjs",
    "check:indices": "node scripts/check-indices.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:ataque": "node scripts/ataque-limite-circulo.mjs",
    "db:ataque:rest": "node scripts/ataque-postgrest.mjs",
    "db:diff": "supabase db diff",
    "db:reset": "node scripts/db-guard.mjs && supabase db reset",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:test": "supabase test db",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "prepare": "husky",
    "proto": "cross-env NOTA_PROTO=1 EXPO_ROUTER_APP_ROOT=./proto/app expo start --clear",
    "start": "expo start",
    "test": "vitest run",
    "token": "node scripts/token.mjs",
    "typecheck": "tsc --noEmit",
    "typecheck:proto": "tsc --noEmit -p proto/tsconfig.json"
  },
  "dependencies": {
    "@expo-google-fonts/archivo": "^0.2.3",
    "@expo-google-fonts/archivo-narrow": "^0.2.3",
    "expo": "~54.0.0",
    "expo-font": "~14.0.0",
    "expo-localization": "~17.0.0",
    "expo-router": "~6.0.0",
    "expo-splash-screen": "~31.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.0",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/pg": "^8.23.1",
    "@types/react": "~19.1.0",
    "babel-plugin-module-resolver": "^5.0.3",
    "cross-env": "^10.1.0",
    "eslint": "^9.39.5",
    "eslint-config-expo": "^10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-react-native": "^5.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "pg": "^8.23.0",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --max-warnings=0 --no-warn-ignored",
      "prettier --ignore-unknown --write"
    ],
    "*.{json,md,sql,yml}": [
      "prettier --ignore-unknown --write"
    ]
  }
}
